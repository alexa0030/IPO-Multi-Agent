# OpenAI-compatible API. Supports OpenAI, DeepSeek, Qwen-compatible gateways, etc.
OPENAI_COMPATIBLE_API_KEY=localtestkey
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPATIBLE_MODEL=qwen3.5-4b

# Java control plane: both switches are required to create and use ChatModel.
# Leave them disabled for deterministic/offline execution and CI.
IPO_CHAT_MODEL=none
IPO_LLM_PLANNER_ENABLED=false
# Spring AI appends its chat-completions path; use the service root, not Python's /v1 URL.
IPO_LLM_BASE_URL=http://127.0.0.1:8000
IPO_LLM_TIMEOUT=300s

LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
LLM_CONTEXT_WINDOW_TOKENS=32768
LLM_CONTEXT_SAFETY_TOKENS=512

PARSE_CHUNK_MAX_CHARS=12000
PARSE_CHUNK_OVERLAP_PAGES=1
CANDIDATE_CONTEXT_PAGES=1

# Optional external research provider. When omitted, the system records
# search_unavailable and does not fabricate industry or market information.
TAVILY_API_KEY=

# auto: use Tavily when configured; ddgs: no-key best effort; off: no web calls.
IPO_SEARCH_PROVIDER=auto
IPO_SEARCH_MAX_QUERIES=12
IPO_SEARCH_MAX_FETCHED_SOURCES=30
# Legal/governance queries use a separate cap so P0 checks cannot crowd out
# industry and competitor research (or vice versa).
IPO_LEGAL_SEARCH_MAX_QUERIES=6
IPO_LEGAL_ENTITY_MAX_QUERIES=10
