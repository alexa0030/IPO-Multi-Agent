{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipo-agent.local/contracts/analysis-request.schema.json",
  "title": "IPO analysis request",
  "type": "object",
  "required": ["company", "documentId", "reportingEntity", "facts"],
  "properties": {
    "company": {"type": "string", "minLength": 1},
    "documentId": {"type": "string", "minLength": 1},
    "reportingEntity": {"type": "string", "minLength": 1},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["factId", "metricCode", "period", "value"],
        "properties": {
          "factId": {"type": "string", "minLength": 1},
          "metricCode": {"type": "string", "minLength": 1},
          "period": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": ["string", "null"]},
          "page": {"type": ["integer", "null"], "minimum": 1},
          "reportingEntity": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
